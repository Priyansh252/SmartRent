# Copy to .env and edit (never commit .env). Read by docker-compose.yml and by the backend (spring.config.import).
# --- MySQL ---
DB_URL=jdbc:mysql://localhost:3306/smartrent?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=smartrent
DB_PASSWORD=change_me_local_db
MYSQL_ROOT_PASSWORD=change_me_local_root

# --- ActiveMQ Artemis ---
ARTEMIS_BROKER_URL=tcp://localhost:61616
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=change_me_local_broker

# --- Application ---
REPORTS_DIR=./reports
# Demo-account passwords created by the seed data (documented in README.md; change for anything non-local)
SEED_ADMIN_PASSWORD=Admin@123
SEED_EMPLOYEE_PASSWORD=Employee@123
SEED_CUSTOMER_PASSWORD=Customer@123
